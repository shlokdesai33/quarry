{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"env": {
		"builtin": true
	},
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "warn"
	},
	"plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
	"rules": {
		"import/no-cycle": "error",
		"eslint/no-fallthrough": "error",
		"eslint/eqeqeq": "error",
		"eslint/no-console": "error",
		"eslint/no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_"
			}
		],
		// oxlint recommends using typescript's noImplicitReturns instead
		"typescript/consistent-return": "off",
		"typescript/no-explicit-any": "off",
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"typescript/await-thenable": "error",
		"typescript/no-unnecessary-type-assertion": "error"
	},
	"overrides": [
		{
			"files": ["test/**"],
			"rules": {
				"typescript/no-explicit-any": "off",
				"typescript/no-unnecessary-type-assertion": "off"
			}
		},
		{
			// benchmark scripts: they report to the console, run their steps in
			// order, and parse untyped compiler output. No tsconfig includes them,
			// so the strictness their assertions answer to is not visible here.
			"files": ["bench/**"],
			"rules": {
				"eslint/no-console": "off",
				"eslint/no-await-in-loop": "off",
				"typescript/no-unsafe-type-assertion": "off",
				"typescript/no-unnecessary-type-assertion": "off"
			}
		}
	],
	"ignorePatterns": ["dist"]
}
